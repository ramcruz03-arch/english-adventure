<?xml version="1.0" encoding="utf-8"?>
<!-- A child's learning record never leaves the device through cloud backup or
     device transfer. Sync, when it ships, will be an explicit parent choice. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
